{
  // Cloudflare Workers setup (free plan). Deploy with the "Deploy to Cloudflare" button in the README,
  // or run: npx wrangler deploy
  "name": "numbers",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  // No database_id on purpose: Cloudflare creates the database on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "numbers-db" }],
  // The site's own address. Cloudflare attaches these names to the Worker on deploy.
  "routes": [
    { "pattern": "basmatameel.com", "custom_domain": true },
    { "pattern": "www.basmatameel.com", "custom_domain": true }
  ],
  "vars": {
    "BASE_URL": "https://basmatameel.com",
    // Google Tag Manager (public pages only; login, account and admin pages never load it)
    "GTM_ID": "GTM-5XCM8XW9",
    // Whoever registers with this phone becomes the admin.
    "ADMIN_PHONE": "0599900079",
    // "true" = every new ad waits for your approval
    "REQUIRE_APPROVAL": "false"
  },
  // Every 3 hours: automatic refresh for verified advertisers, and removal of ads nobody refreshed for a year.
  "triggers": { "crons": ["0 */3 * * *"] },
  "observability": { "enabled": true }
}
