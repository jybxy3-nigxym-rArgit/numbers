# Copy these to your hosting settings (or to a .env file you load yourself).

# Phone number of the admin. Register on the site with this number and you get the admin panel.
ADMIN_PHONE=0500000000

# true = every new ad waits for your approval. false = ads go live at once.
REQUIRE_APPROVAL=false

# Your site address, used in the sitemap and page links. No slash at the end.
BASE_URL=https://example.com

# Set to production on the real server.
NODE_ENV=production

# Where the database lives. Point it at a disk that survives restarts.
DATA_DIR=/data

# Optional: ads are hidden after this many different people report them (default 3).
# REPORT_HIDE_AT=3
# Optional: max live ads per account (default 20).
# MAX_ADS_PER_USER=20
# Optional: how many proxies sit in front of the app (Render = 1, Cloudflare + Render = 2).
# TRUSTED_HOPS=1
